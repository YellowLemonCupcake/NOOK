generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model AdminAccount {
  id       String @id @default(cuid())
  name     String
  username String @unique
  email    String @unique
  password String

  configuration Configuration?
}

model Configuration {
  id String @id @default(cuid())
  speadsheetId String

  adminAccountId String       @unique
  adminAccount   AdminAccount @relation(fields: [adminAccountId], references: [id])
}

model BorrowLog {
  id String @id @default(cuid())

  date        DateTime @default(now())
  bookBarcode String
  bookTitle   String
  bookAuthor  String[]
  callNumber  String
  copies      Int

  borrowerId String
  borrower   Borrower @relation(fields: [borrowerId], references: [id])
  @@index([date])
  @@index([borrowerId, date])
}

model Borrower {
  id String @id @default(cuid())

  idNumber  String @unique
  name      String
  yearLevel Int

  borrowLogs BorrowLog[]

  programId Int
  program   Program @relation(fields: [programId], references: [id])

  collegeId Int
  college   College @relation(fields: [collegeId], references: [id])
}

model PendingRegistration {
  id Int @id @default(autoincrement())

  studentId String
  tableRanges String[] // List of sheet range where inputs for student infos are temporarily emptied
}

model Program {
  id Int @id @default(autoincrement())

  programName String
  programAbbreviation String

  borrowers Borrower[]

  collegeId Int     @unique
  college   College @relation(fields: [collegeId], references: [id])
}

model College {
  id Int @id @default(autoincrement())

  borrowers Borrower[]

  collegeName String
  collegeAbbreviation String
  programs       Program[]
}
