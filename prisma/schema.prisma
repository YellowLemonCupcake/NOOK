generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model AdminAccount {
  id       String @id @default(cuid())
  name     String
  username String @unique
  email    String @unique
  password String

  configuration Configuration?
}

model Configuration {
  id           String @id @default(cuid())
  speadsheetId String

  adminAccountId String       @unique
  adminAccount   AdminAccount @relation(fields: [adminAccountId], references: [id])
}

model BorrowLog {
  id String @id @default(cuid())

  date        DateTime @default(now())
  idNumber    String
  bookBarcode String
  bookTitle   String
  bookAuthor  String[]
  callNumber  String
  copies      Int

  borrower   Borrower? @relation(fields: [idNumber], references: [idNumber])

  @@index([date])
  @@index([idNumber, date])
}

model Borrower {
  id String @id @default(cuid())

  idNumber  String @unique
  name      String
  yearLevel Int
  program   String
  college   String

  borrowLogs BorrowLog[]
}

model PendingRegistration {
  id Int @id @default(autoincrement())

  idNumber   String @unique
  tableRanges String[] // List of sheet range where inputs for student infos were temporarily emptied.
}
